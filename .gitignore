# ============================================================================
# NightWatch .gitignore
# The repo is PUBLIC. Secrets never land here - see .env.example for the list.
# ============================================================================

# --- secrets: must never be committed ---
.env
.env.*
!.env.example
*.pem
*.key
credentials.json

# --- python ---
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# uv.lock IS committed on purpose (pinned dependency versions for the freeze).
# Do not add it here.

# --- node / dashboard build output ---
node_modules/
apps/dashboard/dist/
# generated at deploy from apps/dashboard/dist, mounted read-only (plan 16)
apps/control_plane/static/

# --- runtime artifacts: receipts, evidence bundles, frames, app databases ---
artifacts/
frames/
demo-target/runtime/
# services/frames is Track B source code, not a runtime frame-artifact directory.
!services/frames/
evidence/
*.sqlite
*.sqlite-wal
*.sqlite-shm
# If a seed ever ships as a .sqlite fixture rather than fixtures/store_seed.sql,
# un-ignore it explicitly on the next line.
# !fixtures/*.sqlite

# --- modal ---
.modal/

# --- working notes / agent handoff prompts (kept locally, never published) ---
temp*.md
docs/temp*.md

# --- os / editor ---
.DS_Store
Thumbs.db
.idea/
.vscode/
*.log
