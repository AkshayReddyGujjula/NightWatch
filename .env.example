# ============================================================================
# NightWatch environment - EXAMPLE FILE
# Safe to commit: it contains names and instructions only, never values.
# Copy it to `.env` and fill that in; `.env` is gitignored.
#
# Deployed Modal functions do NOT read this file. For anything that runs on
# Modal, the value must also exist in the matching Modal Secret (named in the
# comments below). This file is for local runs, scripts and tests.
# ============================================================================

# --- vendor keys: exactly two, shared between Akshay and Jazil out-of-band ---

# Google AI Studio key (NOT Google Cloud). Modal secret: `nightwatch-gemini`
# Bound to orchestrate_incident only.
GOOGLE_API_KEY=

# Set at the T+0 preflight after a live structured-output call actually answers.
# Record the model that answered; never guess or leave a marketing name here.
GEMINI_MODEL=

# TypeSafe / Jev key. Modal secret: `nightwatch-typesafe`
# Bound to run_candidate only - it must never enter a candidate sandbox.
TYPESAFE_API_KEY=

# Pinned deliberately. Change only if the preflight proves a different model ID.
TYPESAFE_MODEL=jev-1.13.0

# --- modal -------------------------------------------------------------------

# Which Modal environment this checkout deploys to (plan 16.1):
#   nightwatch-a     Jazil / Track A
#   nightwatch-b     Akshay / Track B
#   nightwatch-demo  integrated app; Jazil is the only deployer
# The Modal CLI stores its own token in ~/.modal.toml; this file does not hold it.
MODAL_ENVIRONMENT=nightwatch-a

# --- policy ------------------------------------------------------------------

# 1 = the LEGACY rollback route is built and live-eligible (committed default).
# Set to 0 only if LEGACY is not built and tested by Gate G3 (plan 14.1).
POLICY_LIVE_A=1

# --- internal tokens: generate each with `openssl rand -hex 32` ---------------
# Never reuse one value for two purposes. EVALUATOR_TOKEN is the oracle's
# credential and must never reach a candidate sandbox, a screenshot or a log.

# Modal secret: `nightwatch-control`  -> control_asgi, orchestrate_incident
NIGHTWATCH_OPERATOR_TOKEN=
CONTROL_EVENT_TOKEN=

# Modal secret: `nightwatch-live-internal`  -> live_store_asgi
LIVE_INTERNAL_TOKEN=

# Modal secret: `nightwatch-provider`  -> provider_asgi
PROVIDER_SIGNING_SECRET=
EVALUATOR_TOKEN=

# Modal secret: `nightwatch-evidence-ingest`  -> run_candidate only, scoped per run/candidate
FRAME_INGEST_TOKEN=

# --- optional services -------------------------------------------------------

# Hosted tracing only if it is actually wired up; otherwise leave empty (plan 21).
LOGFIRE_TOKEN=

# Unused unless a real Conduct interface is supplied; leave empty (plan 2).
CONDUCT_API_KEY=

# --- recorded versions (not secrets; copied into the receipt) ----------------

# Fill in from the preflight: exact CUA Driver and Chromium versions in the
# pinned desktop image. The receipt must show what actually ran.
CUA_DRIVER_VERSION=
CHROMIUM_VERSION=
