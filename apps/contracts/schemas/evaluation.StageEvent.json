{
  "additionalProperties": false,
  "description": "One staged-smoke stage; counts come from actual bucket IDs (plan \u00a714.2).",
  "properties": {
    "failed_probe_ids": {
      "items": {
        "maxLength": 512,
        "minLength": 1,
        "type": "string"
      },
      "title": "Failed Probe Ids",
      "type": "array"
    },
    "held_count": {
      "minimum": 0,
      "title": "Held Count",
      "type": "integer"
    },
    "loss_probe_count": {
      "minimum": 0,
      "title": "Loss Probe Count",
      "type": "integer"
    },
    "normal_probe_count": {
      "minimum": 0,
      "title": "Normal Probe Count",
      "type": "integer"
    },
    "passed": {
      "title": "Passed",
      "type": "boolean"
    },
    "requested_pct": {
      "enum": [
        5,
        25,
        100
      ],
      "title": "Requested Pct",
      "type": "integer"
    },
    "routed_bucket_ids": {
      "items": {
        "maxLength": 512,
        "minLength": 1,
        "type": "string"
      },
      "title": "Routed Bucket Ids",
      "type": "array"
    },
    "routed_count": {
      "minimum": 0,
      "title": "Routed Count",
      "type": "integer"
    }
  },
  "required": [
    "requested_pct",
    "routed_count",
    "held_count",
    "normal_probe_count",
    "loss_probe_count",
    "passed"
  ],
  "title": "StageEvent",
  "type": "object"
}
