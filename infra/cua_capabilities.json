{
  "version": 3,
  "expires_after": "2h",
  "idle_timeout": "20m",
  "allow": {
    "tools": [
      "start_session",
      "end_session",
      "launch_app",
      "list_windows",
      "browser_prepare",
      "get_browser_state",
      "browser_navigate",
      "browser_click",
      "browser_type"
    ]
  },
  "resources": {
    "apps": [
      {
        "executable": "/opt/google/chrome/chrome",
        "launch": true,
        "windows": "all",
        "terminate": "driver_launched"
      }
    ],
    "browser": {
      "profiles": [
        {
          "kind": "existing_profile"
        },
        {
          "kind": "isolated"
        }
      ],
      "origins": [
        "http://127.0.0.1:8080"
      ]
    },
    "desktop": {
      "display": false
    }
  }
}
